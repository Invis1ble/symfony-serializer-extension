{
    "name": "invis1ble/symfony-serializer-extension",
    "type": "library",
    "description": "Additional useful (de)normalizers for symfony/serializer .",
    "authors": [
        {
            "name": "Invis1ble",
            "email": "Invis1ble@users.noreply.github.com"
        }
    ],
    "keywords": [
        "serializer",
        "deserializer",
        "normalizer",
        "denormalizer",
        "uri",
        "url",
        "uriinterface",
        "psr",
        "symfony",
        "extension"
    ],
    "require": {
        "php": ">=8.1",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1||^2.0",
        "symfony/serializer": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.5 || ^13.0",
        "escapestudios/symfony2-coding-standard": "^3.18",
        "friendsofphp/php-cs-fixer": "^3.95",
        "rector/rector": "^2.6",
        "guzzlehttp/psr7": "^2.7 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "Invis1ble\\SymfonySerializerExtension\\": "src/",
            "Invis1ble\\SymfonySerializerExtension\\Tests\\": "tests/"
        },
        "exclude-from-classmap": ["/tests/"]
    },
    "license": "MIT"
}
